# Copy this file to .env and fill in real values — never commit .env

# MongoDB connection string (get from MongoDB Atlas or local instance)
MONGO_URI=mongodb://localhost:27017/prompt-library

# Flask environment: use "production" in deployment, "development" locally only
FLASK_ENV=production

PORT=5000

# Origins allowed to call this API from the browser (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Required for POST/PUT/DELETE on /api/prompts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=
